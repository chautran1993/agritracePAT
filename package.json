{
  "name": "agritrace-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck:plots": "tsc -p tsconfig.plots.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "postinstall": "npm --prefix tooling/eslint ci --ignore-scripts",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test accessibility.spec.ts a11y-interactions.spec.ts auth-notifications.spec.ts standards.spec.ts --project=390px --project=1440px",
    "test:database": "playwright test --config playwright.database.config.ts",
    "db:seed": "tsx scripts/export-database.ts",
    "db:migrate": "wrangler d1 migrations apply agritrace-db --remote"
  },
  "dependencies": {
    "@turf/turf": "^7.4.0",
    "@vitejs/plugin-react": "6.1.2",
    "leaflet": "1.9.4",
    "lucide-react": "1.57.0",
    "maplibre-gl": "^6.14.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-map-gl": "^8.1.3",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "tailwindcss": "^3.4.17",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4",
    "wrangler": "4.152.0"
  }
}
